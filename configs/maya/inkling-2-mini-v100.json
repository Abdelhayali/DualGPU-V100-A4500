{
 "exe": "{root}/kernel/build-maya2/maya-ik2.exe",
 "src": "src-maya2",
 "card": "V100",
 "tokenizer": "{root}/models/inkling-2-mini-maya/ik2/tokenizer",
 "model_name": "inkling-2-mini",
 "reasoning_effort": "low",
 "args": [
  "--model",
  "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL.gguf",
  "--max-context",
  "32768"
 ],
 "env": {
  "IK2_KV": "fp8",
  "IK2_UNSUPPORTED": "1",
  "IK2_WARM": "{root}/kernel/src-maya2/data/expert-profile-ik2mini.bin",
  "IK2_GATE_TILE": "64",
  "IK2_GATE_BF16": "1",
  "IK2_Q8_UNROLL": "1"
 },
 "vision": {
  "exe": "{root}/kernel/build-maya-vision/bin/maya-vision.exe",
  "mmproj": "{root}/models/inkling-2-mini-maya/mmproj-BF16.gguf",
  "model": "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL.gguf",
  "gpu": false,
  "resident": true
 },
 "note": "Maya v1.1.73 (mw00/project-maya, CUDA 12.9, sm_70): Tesla V100 alone, 32k, FP8 KV; 10.9 GiB of the experts in VRAM (Maya's profile), the rest from pinned RAM - 52 tok/s on code, 20-27 on prose; the A4500 stays free"
}
