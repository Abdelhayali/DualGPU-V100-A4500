{
 "exe": "{root}/kernel/build-maya4/maya-ik2.exe",
 "src": "src-maya4",
 "card": "A4500",
 "tokenizer": "{root}/models/inkling-2-mini-maya/ik2/tokenizer",
 "model_name": "inkling-2-mini",
 "reasoning_effort": "low",
 "args": [
  "--model",
  "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL-nvfp4tail.gguf",
  "--max-context",
  "524288",
  "--draft",
  "{root}/models/inkling-2-mini-maya/dspark-Inkling-2-Mini-Q8_0.gguf",
  "--drafting",
  "on"
 ],
 "env": {
  "IK2_KV": "fp8",
  "IK2_UNSUPPORTED": "1",
  "IK2_WARM": "{root}/kernel/src-maya4/data/expert-profile-ik2mini.bin",
  "IK2_GATE_TILE": "64",
  "IK2_GATE_BF16": "1",
  "IK2_Q8_UNROLL": "1",
  "IK2_VISION_GIB": "0",
  "IK2_DRAFT_CTX": "16384"
 },
 "vision": {
  "exe": "{root}/kernel/build-maya-vision/bin/maya-vision.exe",
  "mmproj": "{root}/models/inkling-2-mini-maya/mmproj-BF16.gguf",
  "model": "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL-nvfp4tail.gguf",
  "gpu": false,
  "resident": true
 },
 "note": "DEFAULT: Maya v1.1.75, UD-Q4_K_XL with layers 20-23 experts in NVFP4 (tools/ik2_nvfp4_tail.py, 15.6 GB), RTX A4500 alone, 512k, FP8 KV, GGUF drafter - 118-162 tok/s code, 92-97 prose; 103 after a 143k prompt, 77 after 227k; hard suite 91.1 at 128.5 tok/s. Keep prompts under ~256k: a 287k-token prompt hung the A4500 and crashed Windows (0x133)"
}