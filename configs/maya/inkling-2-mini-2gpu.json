{
 "exe": "{root}/kernel/build-maya4/maya-ik2.exe",
 "src": "src-maya4",
 "card": "A4500|V100",
 "tokenizer": "{root}/models/inkling-2-mini-maya/ik2/tokenizer",
 "model_name": "inkling-2-mini",
 "reasoning_effort": "low",
 "args": [
  "--model",
  "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL.gguf",
  "--max-context",
  "262144",
  "--draft",
  "{root}/models/inkling-2-mini-maya/dspark-Inkling-2-Mini-Q8_0.gguf",
  "--drafting",
  "auto",
  "--gpus",
  "2"
 ],
 "env": {
  "IK2_KV": "fp8",
  "IK2_UNSUPPORTED": "1",
  "IK2_WARM": "{root}/kernel/src-maya4/data/expert-profile-ik2mini.bin",
  "IK2_GATE_TILE": "64",
  "IK2_GATE_BF16": "1",
  "IK2_Q8_UNROLL": "1"
 },
 "vision": {
  "exe": "{root}/kernel/build-maya-vision/bin/maya-vision.exe",
  "mmproj": "{root}/models/inkling-2-mini-maya/mmproj-BF16.gguf",
  "model": "{root}/models/inkling-2-mini-maya/Inkling-2-Mini-UD-Q4_K_XL.gguf",
  "gpu": false,
  "resident": true
 },
 "note": "Maya v1.1.75: RTX A4500 + Tesla V100 (--gpus 2: the A4500 runs the model and the most-picked experts, the V100 holds the next experts, the rest in pinned RAM), 262k, FP8 KV, GGUF drafter with --drafting auto - 69-72 tok/s code, 28-30 prose; slower than the A4500 alone (262k preset)"
}