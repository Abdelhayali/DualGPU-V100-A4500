+from __future__ import annotations
+
+from typing import Iterable, TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+from .base import ModelBase, TextModel, gguf, logger
+
+
+@ModelBase.register("RicursiveForCausalLM")
+@ModelBase.example("ricursiveAI/Ripple-65B-Preview")
+class RicursiveModel(TextModel):
+    """Ricursive Intelligence Ripple: dense, sandwich (PeriNorm) blocks, per-head QK-norm, elementwise sigmoid
+    attention gate (g_proj), value residual from the scaled embeddings, sliding-window RoPE layers with NoPE global
+    layers, SwiGLU with activation clamping."""
+    model_arch = gguf.MODEL_ARCH.RICURSIVE
+
+    _MAP = {
+        "input_layernorm":            gguf.MODEL_TENSOR.ATTN_NORM,
+        "self_attn.q_proj":           gguf.MODEL_TENSOR.ATTN_Q,
+        "self_attn.k_proj":           gguf.MODEL_TENSOR.ATTN_K,
+        "self_attn.v_proj":           gguf.MODEL_TENSOR.ATTN_V,
+        "self_attn.o_proj":           gguf.MODEL_TENSOR.ATTN_OUT,
+        "self_attn.q_norm":           gguf.MODEL_TENSOR.ATTN_Q_NORM,
+        "self_attn.k_norm":           gguf.MODEL_TENSOR.ATTN_K_NORM,
+        "self_attn.g_proj":           gguf.MODEL_TENSOR.ATTN_GATE,
+        "self_attn.value_res_lambda": gguf.MODEL_TENSOR.ATTN_VRES_LAMBDA,
+        "post_attention_layernorm":   gguf.MODEL_TENSOR.ATTN_POST_NORM,
+        "pre_feedforward_layernorm":  gguf.MODEL_TENSOR.FFN_NORM,
+        "post_feedforward_layernorm": gguf.MODEL_TENSOR.FFN_POST_NORM,
+        "mlp.gate_proj":              gguf.MODEL_TENSOR.FFN_GATE,
+        "mlp.up_proj":                gguf.MODEL_TENSOR.FFN_UP,
+        "mlp.down_proj":              gguf.MODEL_TENSOR.FFN_DOWN,
+    }
+
+    def set_vocab(self):
+        self._set_vocab_gpt2()
+        # tokenizer_config.json carries a bare ChatML template (no tools, no reasoning) and gguf-py prefers it over
+        # chat_template.jinja; transformers uses the .jinja file, so embed that one
+        tmpl = self.dir_model / "chat_template.jinja"
+        if tmpl.is_file():
+            self.gguf_writer.add_chat_template(tmpl.read_text(encoding="utf-8"))
+            logger.info("gguf: chat_template from chat_template.jinja (overrides tokenizer_config.json)")
+        # eos_token_id = [<|im_end|>, <|endoftext|>]: the turn end must stop generation too
+        eos = self.hparams.get("eos_token_id")
+        if isinstance(eos, list):
+            tok_eos = self.hparams.get("bos_token_id")
+            extra = [e for e in eos if e != tok_eos]
+            if extra:
+                self.gguf_writer.add_eot_token_id(extra[0])
+                logger.info(f"gguf: eot_token_id = {extra[0]} (from eos list {eos})")
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        hp = self.hparams
+        if not hp.get("use_gated_attention", True):
+            raise NotImplementedError("Ricursive without gated attention is not supported")
+        self.gguf_writer.add_vocab_size(hp["vocab_size"])
+        # only the local (sliding-window) layers are rotary; all of them use the full head_dim
+        self.gguf_writer.add_rope_dimension_count(hp["head_dim"])
+
+        if (sw := hp.get("sliding_window")) and "layer_types" in hp:
+            self.gguf_writer.add_sliding_window(sw)
+            self.gguf_writer.add_sliding_window_pattern([t == "sliding_attention" for t in hp["layer_types"]])
+
+        if (es := hp.get("embed_scale")) is not None:
+            self.gguf_writer.add_embedding_scale(float(es))
+        if (c := hp.get("ffn_clamp_threshold")):
+            self.gguf_writer.add_swiglu_clamp(float(c))
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if name == "model.embed_tokens.weight":
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.TOKEN_EMBD), data_torch
+            return
+        if name == "lm_head.weight":
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.OUTPUT), data_torch
+            return
+        if name == "model.norm.weight":
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.OUTPUT_NORM), data_torch
+            return
+        assert bid is not None, name
+        rest = name.split(f"model.layers.{bid}.", 1)[1]
+        key = rest[:-len(".weight")] if rest.endswith(".weight") else rest
+        if key not in self._MAP:
+            raise ValueError(f"unexpected tensor {name}")
+        yield self.format_tensor_name(self._MAP[key], bid), data_torch.reshape(1) if key.endswith("value_res_lambda") else data_torch
